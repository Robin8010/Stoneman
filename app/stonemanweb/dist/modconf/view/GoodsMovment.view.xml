<mvc:View xmlns:cards="sap.f.cards" controllerName="modconfcontroller.GoodsMovmentList"
     height="100%"
    xmlns:core="sap.ui.core"
    xmlns:l="sap.ui.layout"
    xmlns:f="sap.ui.layout.form"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:T="sap.ui.table"
    xmlns:u="sap.ui.unified"
    xmlns:c="sap.ui.core"
	xmlns:a="sap.ui.core.Control"
>
    <Page
        id="_GMF"
        class="sapUiFioriObjectPage" title=""
        showHeader="true" showNavButton="true" navButtonPress=".navBack"
    > 
     <content>
            <f:SimpleForm
                id="_GoodsMovmentList"
                maxContainerCols="2"
                editable="true"
                layout="ResponsiveGridLayout"
                title="GoodsMovmentList"
                labelSpanL="4"
                labelSpanM="4"
                emptySpanL="0"
                emptySpanM="0"
                columnsL="2"
                columnsM="1"
                validateFieldGroup="onValidateFieldGroup"
            >
     <VBox >



  <Table id="Tbl"  
    items="{GMC>/value}"  
                           growing="true"
                           growingScrollToLoad="true"
                         

                        class="sapUiSizeCompact"
                        sticky="ColumnHeaders,HeaderToolbar"
                        showSeparators="All"
                        showNoData="true"
                        growingThreshold="5"
                        enableBusyIndicator="true"
                        alternateRowColors="true"
                        headerLevel="Auto"
                        backgroundDesign="Translucent">
  <headerToolbar>
  <Toolbar >
  <content>
    <SearchField placeholder="GMC Num" width="30%" liveChange="onSearch"></SearchField>
  
     
   <!-- <SearchField placeholder="Job Work Po" width="30%" liveChange="onSearchWithName"></SearchField>-->
    <ToolbarSpacer />
     <Button type="Accept" enabled="{ENBmodel>/Enable}" text="Addnew" press="Addnew"></Button>

  

  </content>
  </Toolbar>
  </headerToolbar>
							<columns>
              <!--	<Column>
									<Label  text="ID"/>
								</Column>-->
								<Column>
									<Label text="GMC Num"/>
								</Column>
								<Column>
									<Label text="Job Work Po"/>
								</Column>
								<!--<Column>
									<Label text="SKU"/>
								</Column>-->
								<Column width="30%">
									<Label text="SKU Desc"/>
								</Column>
                <Column>
									<Label text="GMC Quantity"/>
								</Column>
                <Column>
									<Label text="Weight"/>
								</Column>
               
                 <Column>
									<Label text="L1 Status"/>
								</Column>
                  <Column>
									<Label text="SupervisorStatus"/>
								</Column>
                 <Column>
									<Label text="L2 Status"/>
								</Column>
                 <Column>
									<Label text="IsPost"/>
								</Column>
                 <Column hAlign="End" >
									<Label text="Edit"/>
								</Column>
							</columns>
							<items>
								<ColumnListItem>
									<cells  >
                  <!--  <Text width="150vh" text="{GMC>ID}"/>-->
                  	<Text text="{GMC>GMCNo}"/>
										<Text text="{GMC>JobworkPo}"/>
										<!-- <Text text="{GMC>SKU}"/>-->
										<Text  text="{GMC>SFGDsc}"/>
                    <Text text="{GMC>GMCQty}"/>
                    <Text text="{GMC>PlecesWeight}"/>
									<!--	<Text text="{GMC>TotalWeight}"/>
                    
										<Text width="150vh" text="{GMC>Creater}"/>
                    <Text width="150vh" text="{GMC>QANM}"/>
                    <Text width="150vh" text="{GMC>NQAName}"/>
                    -->
										<Text text="{GMC>FirstLevelStatus}"/>
                    <Text text="{GMC>SuperwiserStatus}"/>
                     <Text text="{GMC>SecondLevelStatus}"/>
                    <Text text="{GMC>DocumentPosted}"/>
                    <Button hAlign="End" type="Attention" text="Edit" press="onEditPress"></Button>
									</cells>
								</ColumnListItem>
							</items>
						</Table>
          

  </VBox>  
   </f:SimpleForm>
     </content>
     
    </Page>
</mvc:View>
