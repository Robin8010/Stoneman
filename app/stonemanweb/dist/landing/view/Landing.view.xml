                <TileContent id="tc5">
                    <ImageContent id="ic5" src="test-resources/sap/m/demokit/sample/GenericTileAsLaunchTile/images/SAPLogoLargeTile_28px_height.png" />
                </TileContent>
            </GenericTile>

             <GenericTile id="gt6" class="sapUiTinyMarginBegin sapUiTinyMarginTop tileLayout" header="GMC Report"
